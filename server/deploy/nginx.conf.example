# Сервер склада: пример сайта nginx. Замените sklad.example.com, пути и версию PHP-FPM на свои.
# Код лежит в /var/www/sklad (в нём public/, src/, config.php), данные — в /var/lib/sklad (config.php → storage).

server {
    listen 80;
    listen [::]:80;
    server_name sklad.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name sklad.example.com;

    ssl_certificate     /etc/letsencrypt/live/sklad.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sklad.example.com/privkey.pem;

    root /var/www/sklad/public;
    index index.php;

    # Фото коробок и файлы доски — до 40 МБ, APK отдаётся PHP.
    client_max_body_size 50m;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;

    # Миниатюры товаров для телефонов — прямо из каталога данных.
    location /img/ {
        alias /var/lib/sklad/img/;
        expires 1h;
        try_files $uri =404;
    }

    # Доска заданий (статические файлы).
    location /board/ {
        try_files $uri $uri/ /board/index.html;
    }

    # Всё остальное — в index.php (API, страница «Клиенту», установщик агента печати).
    location / {
        try_files $uri /index.php$is_args$args;
    }

    location = /index.php {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_AUTHORIZATION $http_authorization;
        # Адрес клиента для ограничения попыток входа: подставляем настоящий, присланный клиентом заголовок не верим.
        # За обратным прокси — его адрес из set_real_ip_from/real_ip_header.
        fastcgi_param HTTP_X_REAL_IP $remote_addr;
        fastcgi_pass unix:/run/php/php8.5-fpm.sock;
        # Длинный опрос /api/erp/inbox держит запрос до 25 с, отгрузка ждёт службу до 90 с.
        fastcgi_read_timeout 120s;
    }

    # Прочие .php снаружи не доступны.
    location ~ \.php$ {
        return 404;
    }
}
